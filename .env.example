# Copy to .env.local for development. Never commit real values.

# Node backend that /api/* is proxied to (server-side only)
BACKEND_URL=http://localhost:5000

# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth web client ID (public; same value as the backend's GOOGLE_WEB_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
