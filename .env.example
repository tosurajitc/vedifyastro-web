# Copy to .env.local for development. Never commit real values.

# Node backend that /api/* is proxied to (server-side only)
BACKEND_URL=http://localhost:5000

# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth web client ID (public; must be listed in the backend's GOOGLE_WEB_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=702888334450-02sk7hfcokfknn85hqpgbpd0ubtqev1l.apps.googleusercontent.com

# Shared with the backend's WEB_PROXY_SECRET so its rate limits apply per browser (server-side only)
WEB_PROXY_SECRET=
